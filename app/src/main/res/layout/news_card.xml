<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:paddingBottom="5dp"
        android:background="@drawable/corner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/white">

            <ImageView
                android:layout_width="190dp"
                android:layout_height="130dp"
                android:scaleType="centerCrop"
                android:id="@+id/newsCover"
                android:src="@drawable/top_stories"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:id="@+id/tagName"
                android:textColor="@color/purple_500"
                android:text="FEATURE"
                android:fontFamily="@font/formula1_regular"
                android:layout_marginStart="12dp"
                android:padding="3dp"
                android:background="@color/white"
                android:textSize="11sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/headlines"
                android:text="'I want to be winning races in the future' - Bortoleto on his rapid rise to F1 and 'new journey' with Kick Sauber"
                android:textColor="@color/white"
                android:layout_gravity="start"
                android:textSize="16sp"
                android:fontFamily="@font/formula1_regular"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>