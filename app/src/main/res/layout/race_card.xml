<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="7dp"
        app:cardElevation="10dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="90dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="06 - 08 "
                    android:id="@+id/date"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/formula1_regular"/>


                <TextView
                    android:layout_marginTop="2dp"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="DEC"
                    android:textAllCaps="true"
                    android:padding="2dp"
                    android:id="@+id/month"
                    android:background="@drawable/back_txt"
                    android:textAlignment="center"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/formula1_bold"/>



            </LinearLayout>

            <TextView
                android:layout_gravity="center"
                android:layout_width="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_height="match_parent"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:layout_width="270dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="ROUND 24"
                    android:textFontWeight="700"
                    android:textSize="12sp"
                    android:id="@+id/round"
                    android:textColor="@color/purple_500"
                    android:fontFamily="@font/formula1_regular"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="Abu Dhabi"
                    android:id="@+id/location"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/formula1_bold"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:text="FORMULA 1 ETIHAD AIRWAYS ABHU DHABI GRAND PRIX 2024"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:fontFamily="@font/formula1_regular"
                    android:id="@+id/circuit"
                    android:textFontWeight="600"
                    android:textColor="#383737"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"/>


            </LinearLayout>

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center | end"
                android:src="@drawable/baseline_navigate_next_24"/>

        </LinearLayout>




    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>